<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_task_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@drawable/widget_item_background">

    <!-- Checkbox (unchecked state) -->
    <ImageView
        android:id="@+id/widget_checkbox_unchecked"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/widget_checkbox_unchecked"
        android:contentDescription="@string/toggle_task" />

    <!-- Checkbox (checked state - overlaps unchecked) -->
    <ImageView
        android:id="@+id/widget_checkbox_checked"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/widget_checkbox_checked"
        android:visibility="gone"
        android:contentDescription="@string/toggle_task"
        tools:visibility="visible" />

    <!-- Priority star -->
    <ImageView
        android:id="@+id/widget_task_priority"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/widget_star"
        android:visibility="gone"
        android:contentDescription="@string/priority_task"
        tools:visibility="visible" />

    <!-- Task text -->
    <TextView
        android:id="@+id/widget_task_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_checkbox_unchecked"
        android:layout_toStartOf="@id/widget_task_priority"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Buy groceries" />

</RelativeLayout>
